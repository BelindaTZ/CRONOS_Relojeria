# CRONOS — variables de entorno (feature 000)
# Copia este archivo a .env y ajusta solo si hay conflicto de puertos u otros valores locales.
# NUNCA pongas valores reales/secretos aquí: este archivo se versiona.

# --- PostgreSQL ---
POSTGRES_USER=cronos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=cronos
# URL que usa el backend (host "db" = nombre del servicio en docker-compose)
DATABASE_URL=postgresql+psycopg://cronos:changeme@db:5432/cronos

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
# Endpoint de MinIO accesible desde el navegador (fotos, PDFs). En dev = puerto publicado.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PUBLIC_SCHEME=http
MINIO_ROOT_USER=cronos
MINIO_ROOT_PASSWORD=changeme
MINIO_SECURE=false

# --- Auth / JWT (usa >=32 bytes; genera uno con: openssl rand -hex 32) ---
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
PASSWORD_RESET_TTL_HOURS=24

# --- Rate limiting (login y restablecimiento) ---
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_SEGUNDOS=300
LOGIN_BLOQUEO_SEGUNDOS=900

# --- Correo (console | smtp | sendgrid). MailHog local: smtp, host=mailhog puerto 1025 ---
EMAIL_BACKEND=console
EMAIL_FROM=CRONOS <no-reply@cronos.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
APP_BASE_URL=http://127.0.0.1:5173

# --- Semilla de Gerencia General (scripts/seed_gerencia) ---
SEED_GERENCIA_IDENTIFICACION=1700000000
SEED_GERENCIA_NOMBRE=Gerencia General
SEED_GERENCIA_EMAIL=gerencia@cronos.local
SEED_GERENCIA_PASSWORD=changeme-gerencia

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Arranque backend ---
DB_CONNECT_TIMEOUT_SECONDS=60

# --- Frontend ---
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- pgAdmin (perfil opcional "tools") ---
PGADMIN_DEFAULT_EMAIL=admin@cronos.local
PGADMIN_DEFAULT_PASSWORD=changeme


# --- SendGrid (avisos a proveedor / cliente). Pon EMAIL_BACKEND=sendgrid para activarlo. ---
SENDGRID_API_KEY=
# Remitente verificado en tu cuenta de SendGrid (Single Sender o dominio). Si se deja
# vacío se usa la dirección de EMAIL_FROM. SendGrid rechaza el envío si no está verificado.
SENDGRID_FROM_EMAIL=

# ============================================================================
# feature 012 — Plataforma de datos táctico-estratégica (ELT: Postgres → ClickHouse)
# Solo 000 y 012 tocan este archivo / el docker-compose.yml.
# ============================================================================

# --- ClickHouse (warehouse analítico) ---
CLICKHOUSE_USER=cronos
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=wh
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
# Puerto nativo publicado en el host (9100 para no chocar con MinIO API en 9000)
CLICKHOUSE_NATIVE_PORT=9100

# --- Rol de solo lectura sobre la BD operativa, exclusivo del pipeline (DP002) ---
# Lo crea la migración 0029_rol_elt_readonly. NUNCA usar el usuario de la app (POSTGRES_USER).
ELT_PG_RO_USER=cronos_elt_ro
ELT_PG_RO_PASSWORD=changeme

# --- MinIO landing-zone (raw del Extract; nunca fuente de negocio) ---
LANDING_ZONE_BUCKET=landing-zone
# Días de retención de landing-zone antes de que el job de limpieza la borre (FR-012)
LANDING_ZONE_RETENCION_DIAS=30

# --- Airflow (webserver + scheduler, LocalExecutor, DB de metadata PROPIA/separada) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=changeme
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@cronos.local
# Genera uno real con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=dev-only-change-me
AIRFLOW_WEB_PORT=8180
# URL que usa el backend para disparar el DAG vía la REST API de Airflow (mismo compose)
AIRFLOW_BASE_URL=http://airflow-webserver:8080

# --- Frecuencia del DAG elt_operativo: cron de Airflow o alias (@hourly, @daily…) ---
ELT_FRECUENCIA=@hourly